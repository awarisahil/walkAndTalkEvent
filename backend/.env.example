# Server
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/walkandtalk?schema=public"

# Auth
JWT_ACCESS_SECRET=generate-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30

# How long an approved request reserves a place while awaiting payment (minutes)
PAYMENT_RESERVATION_MINUTES=30

# Admin account created by the seed script
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password
SEED_DEMO_DATA=true

# Razorpay (optional — payment buttons stay disabled when unset)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (SMTP) for password-reset OTPs — e.g. Gmail app password:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=app-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
