generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum TicketRequestStatus {
  PENDING
  APPROVED
  REJECTED
  PAYMENT_PENDING
  PAID
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
}

enum CommunityMediaType {
  PHOTO
  VIDEO
  INSTAGRAM
}

model CommunityPost {
  id String @id @default(uuid())

  mediaType CommunityMediaType
  mediaUrl  String
  caption   String?

  eventId String?
  event   Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  addedById String
  addedBy   User   @relation("CommunityPosts", fields: [addedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([mediaType])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model User {
  id                  String   @id @default(uuid())
  name                String
  email               String   @unique
  phone               String?
  age                 Int?
  instagramUsername   String?
  instagramProfileUrl String?
  password            String
  role                UserRole @default(CUSTOMER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticketRequests TicketRequest[]
  payments       Payment[]
  tickets        Ticket[]
  checkedInTickets Ticket[] @relation("CheckedInTickets")
  communityPosts CommunityPost[] @relation("CommunityPosts")
  refreshTokens  RefreshToken[]

  @@index([email])
  @@index([role])
}

model Event {
  id          String  @id @default(uuid())
  title       String
  description String?
  image       String?

  date      DateTime
  startTime String?
  endTime   String?

  venue String

  ticketPrice Decimal @db.Decimal(10, 2)
  capacity    Int

  status EventStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticketRequests TicketRequest[]
  payments       Payment[]
  tickets        Ticket[]
  communityPosts CommunityPost[]

  @@index([date])
  @@index([status])
}

model TicketRequest {
  id String @id @default(uuid())

  userId  String
  eventId String

  status TicketRequestStatus @default(PENDING)

  rejectionReason String?

  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  payment Payment?
  ticket  Ticket?

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@index([status])
}

model Payment {
  id String @id @default(uuid())

  userId          String
  eventId         String
  ticketRequestId String @unique

  amount Decimal       @db.Decimal(10, 2)
  status PaymentStatus @default(PENDING)

  provider          String?
  providerOrderId   String?   @unique
  providerPaymentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketRequest TicketRequest @relation(fields: [ticketRequestId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@index([providerOrderId])
  @@index([providerPaymentId])
}

model Ticket {
  id String @id @default(uuid())

  ticketNumber String @unique

  userId          String
  eventId         String
  ticketRequestId String @unique

  status TicketStatus @default(ACTIVE)

  qrCode String?

  usedAt   DateTime?
  usedById String?
  usedBy   User?    @relation("CheckedInTickets", fields: [usedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketRequest TicketRequest @relation(fields: [ticketRequestId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventId])
  @@index([status])
}


